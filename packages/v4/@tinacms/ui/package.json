{
  "name": "@tinacms/ui",
  "version": "4.0.0-alpha.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "The shared user interface components of TinaCMS v4, built on shadcn/ui and restyled to the TinaCMS design. Add a new component with the shadcn CLI in this directory (pnpm dlx shadcn@latest add <component>), then restyle it. Never re-add an existing component: that overwrites its TinaCMS styling.",
  "type": "module",
  "repository": {
    "url": "https://github.com/tinacms/tinacms.git",
    "directory": "packages/v4/@tinacms/ui"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "types": "tsc",
    "test": "vitest run"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./assets/*": "./src/assets/*",
    "./components/*": {
      "types": "./src/components/*.tsx",
      "default": "./src/components/*.tsx"
    },
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "default": "./src/lib/*.ts"
    },
    "./hooks/*": {
      "types": "./src/hooks/*.ts",
      "default": "./src/hooks/*.ts"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.4.1"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "catalog:",
    "happy-dom": "catalog:",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.3",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}

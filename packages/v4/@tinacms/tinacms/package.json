{
  "name": "@tinacms/tinacms",
  "version": "4.0.0-alpha.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "TinaCMS v4 — plugin-driven, git-native CMS. Single-package rewrite (see ../../../../tinacmsv4 for the architecture spec).",
  "type": "module",
  "repository": {
    "url": "https://github.com/tinacms/tinacms.git",
    "directory": "packages/v4/@tinacms/tinacms"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tinacms-scripts build",
    "dev": "vite playground",
    "types": "tsc",
    "test": "vitest run --passWithNoTests"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/editor/index.ts",
      "default": "./src/editor/index.ts"
    },
    "./preview": {
      "types": "./src/preview/index.ts",
      "default": "./src/preview/index.ts"
    },
    "./adapters/react": {
      "types": "./src/adapters/react/index.ts",
      "default": "./src/adapters/react/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./local-data-layer": {
      "types": "./src/plugins/content/local/local-data-layer.ts",
      "default": "./src/plugins/content/local/local-data-layer.ts"
    },
    "./local-data-layer/vite": {
      "types": "./src/plugins/content/local/local-data-layer.vite.ts",
      "default": "./src/plugins/content/local/local-data-layer.vite.ts"
    },
    "./adapters/next": {
      "types": "./src/adapters/next/index.ts",
      "default": "./src/adapters/next/index.ts"
    },
    "./adapters/express": {
      "types": "./src/adapters/express/index.ts",
      "default": "./src/adapters/express/index.ts"
    },
    "./adapters/astro": {
      "types": "./src/adapters/astro/index.ts",
      "default": "./src/adapters/astro/index.ts"
    },
    "./adapters/hono": {
      "types": "./src/adapters/hono/index.ts",
      "default": "./src/adapters/hono/index.ts"
    }
  },
  "dependencies": {
    "@ariakit/react": "catalog:",
    "@headlessui/react": "2.1.8",
    "@heroicons/react": "^1.0.6",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-dialog": "catalog:",
    "@radix-ui/react-dropdown-menu": "catalog:",
    "@radix-ui/react-popover": "catalog:",

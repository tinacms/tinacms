---
/**
 * Recursive text-formatting renderer. Each formatting flag (bold, italic,
 * underline, strikethrough, code, highlight, textColor) wraps the node in its
 * tag and recurses via `Astro.self` with that flag cleared, so combinations
 * stack naturally (`<strong><em><code>...</code></em></strong>`). A text
 * colour on highlighted text folds into the `<mark>` instead of a `<span>`.
 */
import { sanitizeCssColor } from './sanitize';
import type { TextElement } from './types';

interface Props {
  node: TextElement;
}

const { node } = Astro.props;
// Colours that aren't a plain CSS colour are dropped; the text still renders.
const highlightColor = sanitizeCssColor(node.highlightColor);
const textColor = sanitizeCssColor(node.textColor);
const markStyle =
  [
    highlightColor && `background-color:${highlightColor}`,
    textColor && `color:${textColor}`,
  ]
    .filter(Boolean)
    .join(';') || undefined;
---
{node.bold ? (
  <strong>
    <Astro.self node={{ ...node, bold: false }} />
  </strong>
) : node.italic ? (
  <em>
    <Astro.self node={{ ...node, italic: false }} />
  </em>
) : node.underline ? (
  <u>
    <Astro.self node={{ ...node, underline: false }} />
  </u>
) : node.strikethrough ? (
  <s>
    <Astro.self node={{ ...node, strikethrough: false }} />
  </s>
) : node.code ? (
  <code>
    <Astro.self node={{ ...node, code: false }} />
  </code>
) : node.highlight ? (
  <mark style={markStyle}>
    <Astro.self node={{ ...node, highlight: false, highlightColor: undefined, textColor: undefined }} />
  </mark>
) : textColor ? (
  <span style={`color:${textColor}`}>
    <Astro.self node={{ ...node, textColor: undefined }} />
  </span>
) : (
  <Fragment>{node.text}</Fragment>
)}

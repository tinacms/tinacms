#!/usr/bin/env node

const version = process.version.slice(1);
const [major] = version.split('.');
if (major < 22) {
  console.error(
    'ERROR: Node.js version lower than 22 is not supported in tinacms, please update to the latest LTS version. See https://nodejs.org/en/download/ for more details'
  );
  process.exit(1);
} else {
  const [node, app, ...args] = process.argv;
  import('../dist/index.js')
    .then((cli) => {
      cli.default.runExit(args);
    })
    .catch((err) => {
      console.error('Failed to load CLI:', err);
      process.exit(1);
    });
}

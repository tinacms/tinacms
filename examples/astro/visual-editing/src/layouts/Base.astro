---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { isEditMode } from '@tinacms/astro/is-edit-mode';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import { getGlobal } from '../lib/data';
import { islands } from '../lib/islands';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'TinaCMS Astro visual editing' } = Astro.props;

const global = await getGlobal();
const editing = isEditMode(Astro.request);

const themeColor = global.data.global?.theme?.color ?? 'blue';
const darkMode = global.data.global?.theme?.darkMode ?? 'system';
const themeFont = global.data.global?.theme?.font ?? 'sans';
const fontClass =
  themeFont === 'nunito'
    ? 'font-nunito'
    : themeFont === 'lato'
      ? 'font-lato'
      : 'font-sans';
---
<!DOCTYPE html>
<html lang="en" data-theme={themeColor}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline define:vars={{ darkMode }}>
      (function(){
        const root = document.documentElement;
        if (darkMode === 'dark') root.classList.add('dark');
        else if (darkMode === 'light') root.classList.remove('dark');
        else if (window.matchMedia('(prefers-color-scheme: dark)').matches) root.classList.add('dark');
      })();
    </script>
  </head>
  <body class:list={['antialiased min-h-screen flex flex-col', fontClass]}>
    <TinaIsland name="global" wrapper={islands.global.wrapper} params={{ path: Astro.url.pathname }}>
      <Header
        data={global.data.global?.header ?? null}
        pathname={Astro.url.pathname}
        theme={editing ? global.data.global?.theme : undefined}
      />
    </TinaIsland>
    <main class="flex-1">
      <slot />
    </main>
    <TinaIsland name="global-footer" wrapper={islands['global-footer'].wrapper} params={{ path: Astro.url.pathname }}>
      <Footer data={global.data.global?.footer ?? null} />
    </TinaIsland>
    {editing && (
      <script is:inline>
        // The theme lives on <html> and <body>, outside every island, so copy
        // it from the header island each time the bridge swaps that in.
        (function () {
          const island = document.querySelector('[data-theme-sync]')?.closest('[data-tina-island]');
          if (!island) return;
          const fonts = { sans: 'font-sans', nunito: 'font-nunito', lato: 'font-lato' };
          new MutationObserver(() => {
            const theme = island.querySelector('[data-theme-sync]');
            if (!theme) return;
            const { color, darkMode, font } = theme.dataset;
            const root = document.documentElement;
            root.dataset.theme = color || 'blue';
            root.classList.toggle(
              'dark',
              darkMode === 'dark' ||
                (darkMode !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches)
            );
            document.body.classList.remove(...Object.values(fonts));
            document.body.classList.add(fonts[font] ?? 'font-sans');
          }).observe(island, { childList: true });
        })();
      </script>
    )}
  </body>
</html>
